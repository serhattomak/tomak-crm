# Local environment contract for the Docker Compose stack.
#
# OPTIONAL. Every value below is already the default baked into
# `docker-compose.yml`, so `docker compose up -d` — and Docker Desktop's Start
# button — work with no .env at all. Copy this file to `.env` only to override
# something (a port clash, for example).
#
# `.env` is gitignored; this template is not.

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# These four are the ports this repo has always used; `docs/agents/environment.md`
# and `supabase/config.toml` both assume them.
POSTGRES_PORT=54322
SUPABASE_PORT=54321
STUDIO_PORT=54323
MAILPIT_PORT=54324
# Realtime is published for direct debugging. The app reaches it through Kong at
# http://127.0.0.1:54321/realtime/v1/.
REALTIME_PORT=54325

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Supabase local-dev keys
# ---------------------------------------------------------------------------
# These are Supabase's *published* local-dev values, not secrets, and they are
# signed with SUPABASE_JWT_SECRET below. The same anon / service-role keys are
# already committed in two other places in this repo:
#
#   apps/web/.env.local                                     (URL + anon key)
#   apps/api/src/CRM.BuildingBlocks/Storage/SupabaseStorageOptions.cs
#                                                           (URL + service key)
#
# All three must agree. Rotating the secret without regenerating and re-committing
# those keys breaks login and file uploads with no obvious error.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ---------------------------------------------------------------------------
# Auth (GoTrue)
# ---------------------------------------------------------------------------
# Mirrors `[auth] site_url` in supabase/config.toml.
SITE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Realtime
# ---------------------------------------------------------------------------
# Both are local-dev placeholders. DB_ENC_KEY must be >= 16 chars and
# SECRET_KEY_BASE >= 64, or the container refuses to boot.
REALTIME_DB_ENC_KEY=supabaserealtime
REALTIME_SECRET_KEY_BASE=crm-local-realtime-secret-key-base-change-me-in-production-0123456789
