# E-Commerce Storefront — environment template
# Copy to .env.local and fill values. Same Supabase project as CRM (Q17).
# CRM is the source of truth — ecommerce only calls CRM public HTTP API (Q7/Q12).

# --- Supabase (shared project) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- CRM Public API (Q7/Q17) ---
# Browser uses /api proxy (next.config rewrites → localhost:5000), server uses CRM_API_URL directly.
CRM_API_URL=http://localhost:5000
NEXT_PUBLIC_CRM_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Optional HMAC for public endpoints (Q7) ---
# If set, EcommerceClient adds X-HMAC-Signature + X-Request-Timestamp (server only).
# Must match CRM's ECOMMERCE_HMAC_SECRET / CRM_HMAC_SECRET.
ECOMMERCE_HMAC_SECRET=

# --- App ---
# Dev runs on :3001 so CRM web (:3000) and ecommerce can run side-by-side.
# NEXT_PUBLIC_SITE_URL=https://ecommerce.example.com
