{
  "name": "crm-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "db:migrate": "supabase db push --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "db:migrate:status": "supabase migration list --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "db:psql": "docker exec -it crm-supabase-db psql -U postgres -d postgres",
    "dev": "turbo dev",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:restart": "docker compose restart",
    "docker:up": "docker compose up -d",
    "fix": "ultracite fix",
    "format": "biome format --write .",
    "guard:crm-ui": "node scripts/crm-ui-guard.mjs",
    "guard:crm-ui:full": "node scripts/crm-ui-guard.mjs --full",
    "guard:crm-ui:fixtures": "node scripts/crm-ui-guard.fixtures.mjs",
    "lint": "turbo lint",
    "test": "turbo test",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "ultracite": "^7.10.5"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20"
  }
}
