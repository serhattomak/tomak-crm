{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Store design-system tokens — single source of truth for --store-* CSS variables (mirrors packages/ui/src/styles/globals.css). Tailwind v4 @theme inline bridges via --color-store-*, --radius-store-*, --shadow-store-*. Store theme is light only (mercan), data-store-theme=mercan.",
  "store": {
    "colors": {
      "primary": {
        "cssVar": "--store-primary",
        "value": "oklch(0.64 0.18 35)",
        "darkValue": "oklch(0.64 0.18 35)",
        "type": "color",
        "description": "Store primary mercan/terracotta — tenant-overridable via data-store-theme inline --store-primary (see layout.tsx StorefrontDto.storeTheme). Used for CTAs, links, active states."
      },
      "primaryForeground": {
        "cssVar": "--store-primary-foreground",
        "value": "oklch(0.99 0 0)",
        "darkValue": "oklch(0.99 0 0)",
        "type": "color",
        "description": "Foreground for primary surfaces (text/icon on primary background)."
      },
      "accent": {
        "cssVar": "--store-accent",
        "value": "oklch(0.95 0.04 35)",
        "darkValue": "oklch(0.95 0.04 35)",
        "type": "color",
        "description": "Subtle accent fill for badges, hover, featured ribbons — mercan tint."
      },
      "accentForeground": {
        "cssVar": "--store-accent-foreground",
        "value": "oklch(0.32 0.14 35)",
        "darkValue": "oklch(0.32 0.14 35)",
        "type": "color",
        "description": "Foreground for accent surfaces."
      },
      "surface": {
        "cssVar": "--store-surface",
        "value": "oklch(0.98 0.01 85)",
        "darkValue": "oklch(0.98 0.01 85)",
        "type": "color",
        "description": "Store surface warm stone — cards, gallery, product page panels. Maps to @theme --color-store-surface."
      },
      "surfaceForeground": {
        "cssVar": "--store-surface-foreground",
        "value": "oklch(0.18 0.02 30)",
        "darkValue": "oklch(0.18 0.02 30)",
        "type": "color",
        "description": "Foreground for surface — ink."
      },
      "ink": {
        "cssVar": "--store-ink",
        "value": "oklch(0.18 0.02 30)",
        "darkValue": "oklch(0.18 0.02 30)",
        "type": "color",
        "description": "Store ink — primary text on warm stone, oklch(0.18 0.02 30)."
      },
      "muted": {
        "cssVar": "--store-muted",
        "value": "oklch(0.96 0.03 35)",
        "darkValue": "oklch(0.96 0.03 35)",
        "type": "color",
        "description": "Muted background for skeletons, disabled states, variant pills inactive — mercan tint."
      },
      "mutedForeground": {
        "cssVar": "--store-muted-foreground",
        "value": "oklch(0.52 0.03 30)",
        "darkValue": "oklch(0.52 0.03 30)",
        "type": "color",
        "description": "Muted foreground (secondary text, placeholders) — ink muted."
      },
      "border": {
        "cssVar": "--store-border",
        "value": "oklch(0.90 0.03 35)",
        "darkValue": "oklch(0.90 0.03 35)",
        "type": "color",
        "description": "Store border — cards, inputs, gallery thumbnails — mercan 35 hue."
      },
      "ring": {
        "cssVar": "--store-ring",
        "value": "oklch(0.64 0.18 35)",
        "darkValue": "oklch(0.64 0.18 35)",
        "type": "color",
        "description": "Focus ring (matches primary mercan). Used for quantity stepper, variant focus."
      }
    },
    "radius": {
      "sm": {
        "cssVar": "--store-radius-sm",
        "value": "0.75rem",
        "type": "dimension",
        "description": "Small radius — badges, quantity stepper buttons, breadcrumbs pills."
      },
      "default": {
        "cssVar": "--store-radius",
        "value": "1rem",
        "type": "dimension",
        "description": "Default store radius — card 1rem (Q4)."
      },
      "lg": {
        "cssVar": "--store-radius-lg",
        "value": "1rem",
        "type": "dimension",
        "description": "Large radius — product cards, gallery main image — 1rem."
      },
      "xl": {
        "cssVar": "--store-radius-xl",
        "value": "1.25rem",
        "type": "dimension",
        "description": "Extra-large — hero bento section."
      },
      "2xl": {
        "cssVar": "--store-radius-2xl",
        "value": "1.5rem",
        "type": "dimension",
        "description": "2XL — featured hero, gallery lightbox — 1.5rem."
      }
    },
    "shadow": {
      "sm": {
        "cssVar": "--store-shadow-sm",
        "value": "0 1px 3px oklch(0 0 0 / 0.05)",
        "darkValue": "0 1px 3px oklch(0 0 0 / 0.05)",
        "type": "shadow",
        "description": "Subtle shadow — variant pills, stepper."
      },
      "default": {
        "cssVar": "--store-shadow",
        "value": "0 4px 20px oklch(0 0 0 / 0.06)",
        "darkValue": "0 4px 20px oklch(0 0 0 / 0.06)",
        "type": "shadow",
        "description": "Default card shadow — product card, gallery thumbnails."
      },
      "lg": {
        "cssVar": "--store-shadow-lg",
        "value": "0 8px 30px oklch(0 0 0 / 0.06)",
        "darkValue": "0 8px 30px oklch(0 0 0 / 0.06)",
        "type": "shadow",
        "description": "Large soft shadow 0 8px 30px oklch(0 0 0 / .06) — card hover, dropdowns, sticky bar."
      },
      "xl": {
        "cssVar": "--store-shadow-xl",
        "value": "0 16px 40px oklch(0 0 0 / 0.08)",
        "darkValue": "0 16px 40px oklch(0 0 0 / 0.08)",
        "type": "shadow",
        "description": "Extra-large — modals, gallery zoom."
      }
    },
    "grid": {
      "maxWidth": {
        "cssVar": "--store-grid-max-width",
        "value": "80rem",
        "type": "dimension",
        "description": "Store content max-width 1280px (80rem). Used for .max-w-store-grid-max / max-w-6xl successor."
      },
      "gutter": {
        "cssVar": "--store-grid-gutter",
        "value": "1rem",
        "type": "dimension",
        "description": "Grid gutter (px-4). Horizontal padding for store layout."
      },
      "columns": {
        "cssVar": "--store-grid-columns",
        "value": "12",
        "type": "number",
        "description": "Grid columns for store layout (Tailwind grid-cols-12)."
      }
    },
    "fonts": {
      "sans": {
        "cssVar": "--store-font",
        "value": "var(--font-sans)",
        "type": "fontFamily",
        "description": "Store sans — maps to next/font Inter variable --font-sans."
      },
      "display": {
        "cssVar": "--store-font-display",
        "value": "var(--font-serif)",
        "type": "fontFamily",
        "description": "Display/heading — Playfair_Display --font-serif for product titles."
      }
    },
    "spacing": {
      "gridMax": {
        "cssVar": "--store-grid-max-width",
        "value": "80rem",
        "type": "dimension",
        "description": "Alias for grid.maxWidth for Tailwind spacing token --spacing-store-grid-max."
      },
      "gridGutter": {
        "cssVar": "--store-grid-gutter",
        "value": "1rem",
        "type": "dimension",
        "description": "Alias for grid.gutter for --spacing-store-grid-gutter."
      }
    },
    "themeBridge": {
      "description": "Tailwind v4 @theme inline bridge — maps CSS vars to utility classes (bg-store-primary, text-store-muted, rounded-store-lg, shadow-store). Single source globals.css, oklch only.",
      "mappings": {
        "--color-store-primary": "var(--store-primary)",
        "--color-store-primary-foreground": "var(--store-primary-foreground)",
        "--color-store-accent": "var(--store-accent)",
        "--color-store-accent-foreground": "var(--store-accent-foreground)",
        "--color-store-surface": "var(--store-surface)",
        "--color-store-surface-foreground": "var(--store-surface-foreground)",
        "--color-store-ink": "var(--store-ink)",
        "--color-store-muted": "var(--store-muted)",
        "--color-store-muted-foreground": "var(--store-muted-foreground)",
        "--color-store-border": "var(--store-border)",
        "--color-store-ring": "var(--store-ring)",
        "--radius-store-sm": "var(--store-radius-sm)",
        "--radius-store": "var(--store-radius)",
        "--radius-store-lg": "var(--store-radius-lg)",
        "--radius-store-xl": "var(--store-radius-xl)",
        "--radius-store-2xl": "var(--store-radius-2xl)",
        "--shadow-store-sm": "var(--store-shadow-sm)",
        "--shadow-store": "var(--store-shadow)",
        "--shadow-store-lg": "var(--store-shadow-lg)",
        "--shadow-store-xl": "var(--store-shadow-xl)",
        "--spacing-store-grid-max": "var(--store-grid-max-width)",
        "--spacing-store-grid-gutter": "var(--store-grid-gutter)",
        "--font-store": "var(--store-font)",
        "--font-store-display": "var(--store-font-display)"
      },
      "tenantHook": {
        "selector": "[data-store-theme]",
        "cssVar": "--store-primary",
        "source": "StorefrontDto.storeTheme (EcommerceClient.getStorefront)",
        "usage": "<div data-store-theme=\"mercan\" style=\"--store-primary: oklch(0.64 0.18 35)\">",
        "darkHook": "color-scheme: light only — no .dark store overrides; store is light only per Q2.",
        "logoUrl": "Tenant logoUrl if present — render with next/image in header; fallback ShoppingBag icon"
      }
    }
  }
}
