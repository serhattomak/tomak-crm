# Dependencies
node_modules/

# ---------------------------------------------------------------------------
# Nested repository.
# `crm-monorepo/` is its own git repo (apps/web, apps/api, packages/ui).
# This outer repo tracks the domain docs + tooling that govern it
# (AGENTS.md, docs/, biome.jsonc). Ignoring the nested repo avoids the
# "embedded repository" pitfall while keeping both histories clean.
# ---------------------------------------------------------------------------
crm-monorepo/

# Build / tool caches
.turbo/
.tmp/
graphify-out/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Agent tool local state (caches / possible credentials) — never tracked
.kilo/
.kilocode/
.commandcode/
.hallmark/
.minimax/
.qwen/
.claude/

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
*.log

# Environment
.env
.env.*
