# Testing & Coverage
# ============================================================================
coverage/
*.lcov

# ============================================================================
# Playwright
# ============================================================================
test-results/
playwright-report/
blob-report/
.playwright/
# Saved signed-in session — contains a real auth token, never tracked
.auth/

# ============================================================================
# Next.js & Web
# ============================================================================
.next/
out/
build/
dist/

# ============================================================================
# Turbo & Cache
# ============================================================================
.turbo/
*.tsbuildinfo
next-env.d.ts

# ============================================================================
# Supabase & Local Services
# ============================================================================
.supabase/
rabbitmq_data/
redis_data/
# Local dev seed data. It carries a dev password, so the TEMPLATE (seed.sql.example)
# is what gets committed, never this file. Supabase runs supabase/seed.sql after all
# migrations, on `supabase start` and on every `supabase db reset`.
supabase/seed.sql
# Supabase CLI scratch. These two were committed before these ignore rules
# existed IN THIS REPO — the rules that did exist were in the other repo's
# .gitignore, which does not apply here. Note that an ignore rule never untracks
# a tracked file; `git rm --cached` in the same commit is what does that.
supabase/.branches/
supabase/.temp/

# ============================================================================
# Environment & Secrets
# ============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ============================================================================
# Logs & Debug
# ============================================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================================
# OS & Misc
# ============================================================================
.DS_Store
Thumbs.db
*.pem
.vercel/

inspo/
graphify-out/*